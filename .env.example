# ============================================================
# CloakSight — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------ General ------
CLOAKSIGHT_ENV=development
# Options: development | staging | production

CLOAKSIGHT_LOG_LEVEL=debug
# Options: debug | info | warn | error

# ------ Cloud Agent Provider (Phase 7) ------
# Select which LLM/VLM provider to use.
# The extension NEVER receives this key; it is only used server-side.
AGENT_PROVIDER=
# Options: openai | google | anthropic | local

AGENT_MODEL=
# Example: gpt-4o | gemini-1.5-pro | claude-3-5-sonnet | llava-1.6

AGENT_API_KEY=
# IMPORTANT: Never put a real API key here. Add it to your private .env only.

# ------ FastAPI Server (Phase 7) ------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_CORS_ORIGINS=chrome-extension://*

# ------ Privacy Settings (Phase 6) ------
# Minimum confidence score for PII detection to trigger redaction (0.0 - 1.0)
PII_CONFIDENCE_THRESHOLD=0.85

# Block transmission if leak guard detects unredacted PII
LEAK_GUARD_BLOCK_ON_DETECTION=true

# ------ ONNX / WebGPU (Phase 4+) ------
# Path to ONNX model weights relative to extension/models/
# Leave blank until models are downloaded
OCR_MODEL_PATH=
VISUAL_DETECTOR_MODEL_PATH=
PII_NER_MODEL_PATH=

# ------ Dashboard (Phase 9) ------
DASHBOARD_PORT=5173
