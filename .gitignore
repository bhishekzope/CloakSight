# ============================================================
# CloakSight — .gitignore
# ============================================================

# ------ Environment & Secrets ------
.env
.env.local
.env.*.local
*.pem
*.key
*.secret

# ------ Node / npm ------
node_modules/
dist/
build/
.cache/
*.tsbuildinfo
.parcel-cache/
.vite/

# ------ Extension build output ------
extension/dist/
extension/build/
extension/*.crx
extension/*.zip

# ------ Python ------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
.env/
ENV/
pip-wheel-metadata/
*.egg-info/
*.egg
.eggs/
dist/
*.so
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------ ML Models (never commit large model files) ------
*.onnx
*.pt
*.pth
*.safetensors
*.bin
*.gguf
models/weights/
models/cache/

# ------ OS ------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------ IDE ------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ------ Logs ------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ------ Test Coverage ------
coverage/
.nyc_output/
lcov.info

# ------ Playwright ------
test-results/
playwright-report/
playwright/.cache/

# ------ Dashboard ------
dashboard/dist/
dashboard/node_modules/

# ------ Misc ------
*.tmp
*.temp
.gemini/
